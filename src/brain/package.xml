<?xml version="1.0"?>
<package format="3">
	<name>brain</name>
	<version>0.0.0</version>
	<description>Brain controller node for the vehicle (C++ node using MAVROS messages)</description>
	<maintainer email="you@example.com">kushion</maintainer>
	<license>Apache-2.0</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<build_depend>rclcpp</build_depend>
	<build_depend>mavros_msgs</build_depend>
	<build_depend>geographic_msgs</build_depend>
	<build_depend>sensor_msgs</build_depend>
	<build_depend>interfaces</build_depend>
	<build_depend>std_srvs</build_depend>


	<exec_depend>rclcpp</exec_depend>
	<exec_depend>mavros_msgs</exec_depend>
	<exec_depend>geographic_msgs</exec_depend>
	<exec_depend>sensor_msgs</exec_depend>
	<exec_depend>interfaces</exec_depend>
	<exec_depend>std_srvs</exec_depend>

	<test_depend>ament_lint_auto</test_depend>
	<test_depend>ament_lint_common</test_depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>
</package>
